#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        lsft {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <14 15>;
        };

        rshft {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <21 20>;
        };

        lpar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
        };

        rpar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 19>;
        };

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <4 3>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <7 8>;
        };

        lbrack {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 27>;
        };

        rbrack {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <32 31>;
        };

        cplus {
            bindings = <&kp PLUS>;
            key-positions = <17 18>;
        };

        cminus {
            bindings = <&kp KP_MINUS>;
            key-positions = <29 30>;
        };

        ccaps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <13 14 15 16>;
        };
    };

    behaviors {
        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        caps: caps {
            compatible = "zmk,behavior-hold-tap";
            label = "CAPS";
            bindings = <&kp>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp Q      &kp W     &kp E            &kp R        &kp T      &kp Y        &kp U        &kp I          &kp O    &kp P     &kp BSPC
&mt LCTRL ESCAPE  &kp A      &kp S     &kp D            &kp F        &kp G      &kp H        &kp J        &kp K          &kp L    &kp SEMI  &mt RCTRL APOSTROPHE
&kp LSHIFT        &kp Z      &kp X     &kp C            &kp V        &kp B      &kp N        &kp M        &kp COMMA      &kp DOT  &kp FSLH  &mt RSHIFT ENTER
&caps CAPS 0      &kp LCTRL  &kp LALT  &lt 2 BACKSPACE  &lt 1 SPACE  &kp LCTRL  &lt 3 ENTER  &lt 1 SPACE  &kp RIGHT_ALT  &trans   &trans    &kp RIGHT_WIN
            >;
        };

        lower_layer {
            bindings = <
&kp LS(TILDE)  &kp LS(EXCL)       &kp LS(AT)    &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)    &kp LS(RPAR)          &kp LS(NON_US_BACKSLASH)
&kp GRAVE      &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6   &kp N7        &kp NUMBER_8   &kp NUMBER_9    &kp NUMBER_0          &kp NON_US_BACKSLASH
&kp K_VOL_UP   &kp K_VOLUME_DOWN  &kp K_MUTE    &kp DEL        &kp MINUS     &kp LS(MINUS)  &kp LS(EQUAL)  &kp EQUAL     &kp LS(COMMA)  &kp LS(PERIOD)  &kp LS(SINGLE_QUOTE)  &trans
&trans         &trans             &trans        &trans         &trans        &trans         &trans         &trans        &trans         &trans          &trans                &trans
            >;
        };

        raise_layer {
            bindings = <
&kp F1  &kp F2  &kp F3             &kp F4             &kp F5          &kp F6           &kp F7          &kp F8          &kp F9        &kp F10        &kp F11     &kp F12
&trans  &trans  &kp K_SCROLL_DOWN  &kp K_SCROLL_DOWN  &kp K_BACK      &kp K_FORWARD    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT      &kp DELETE  &kp INS
&trans  &trans  &trans             &trans             &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp HOME        &kp END         &kp PAGE_UP   &kp PAGE_DOWN  &trans      &trans
&trans  &trans  &trans             &trans             &trans          &trans           &trans          &trans          &trans        &trans         &trans      &trans
            >;
        };

        adjust_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp KP_NUMLOCK   &kp KP_N7   &kp KP_N8   &kp KP_N9     &kp KP_EQUAL  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &kp KP_DIVIDE    &kp KP_N4   &kp KP_N5   &kp KP_N6     &kp KP_MINUS  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &kp KP_MULTIPLY  &kp KP_N1   &kp KP_N2   &kp KP_N3     &kp KP_PLUS   &kp KP_ENTER
&trans      &trans        &trans        &trans        &trans        &trans        &kp KP_N0        &kp KP_DOT  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP
            >;
        };
    };
};
